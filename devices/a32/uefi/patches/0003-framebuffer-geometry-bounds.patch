+STATIC
+BOOLEAN
+GeometryFitsRegion (
+  IN EFI_PHYSICAL_ADDRESS FbBase,
+  IN UINT64               FbLength)
+{
+  UINT64 Offset, Bytes;
+  UINT8 Scale;
+
+  if (FbLength < FB_HANDOFF_OFFSET || FbBase > MAX_UINT64 - FbLength ||
+      FB_BPP == 0 || FB_BPP > 4 || FB_WIDTH == 0 || FB_HEIGHT == 0 ||
+      (UINT64)FB_WIDTH * FB_BPP > FB_PITCH || mFbGeometry.Base < FbBase) {
+    return FALSE;
+  }
+  Offset = mFbGeometry.Base - FbBase;
+  Bytes = (UINT64)FB_PITCH * FB_HEIGHT;
+  // The handoff and cursor occupy the final bytes, outside pixel storage.
+  if (Offset > FbLength - FB_HANDOFF_OFFSET ||
+      Bytes > FbLength - FB_HANDOFF_OFFSET - Offset) {
+    return FALSE;
+  }
+  Scale = GetFontScale ();
+  return Scale != 0 && FB_WIDTH / ((FONT_WIDTH + 1) * Scale) != 0 &&
+         FB_HEIGHT / ((FONT_HEIGHT - 4) * Scale) != 0;
+}
